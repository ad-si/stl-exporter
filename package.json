{
  "name": "stl-exporter",
  "version": "0.3.6",
  "description": "Convert face-vertex, or polygon meshes to ascii and binary STLs",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "stl-exporter": "./dist/cli-bin.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "npm run build"
  },
  "keywords": [
    "STL"
  ],
  "author": "Adrian Sieber",
  "license": "MIT",
  "dependencies": {
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.0",
    "stl-models": "^0.12.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.8"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Lowfab/stl-exporter.git"
  },
  "bugs": {
    "url": "https://github.com/Lowfab/stl-exporter/issues"
  },
  "homepage": "https://github.com/Lowfab/stl-exporter"
}
